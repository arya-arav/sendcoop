{
  "name": "@sendcoop/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./custom-fields": "./src/custom-fields.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "vitest run",
    "seed:subscribers": "tsx --env-file-if-exists=../../.env src/scripts/seed-subscribers.ts",
    "bench:subscribers": "tsx --env-file-if-exists=../../.env src/scripts/bench-subscribers.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
