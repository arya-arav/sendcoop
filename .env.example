# Ports for local development
WEB_PORT=3000
EDGE_PORT=3001
WORKER_HEALTH_PORT=3002

# Services from docker-compose.yml
DATABASE_URL=postgres://sendcoop:sendcoop@localhost:5434/sendcoop
REDIS_URL=redis://localhost:6381

# Mailpit catches all mail in development: http://localhost:8027
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
# Development only: lets sending servers use private hosts like Mailpit on
# localhost. Leave unset in production (blocks SSRF to internal services).
ALLOW_PRIVATE_SMTP_HOSTS=true
# Development only: send SES traffic to a local emulator (aws-ses-v2-local).
# SES_ENDPOINT=http://localhost:8005
# Public media (email images): S3-compatible storage. Development uses
# RustFS from docker-compose; production AWS S3 or Cloudflare R2 (leave
# S3_ENDPOINT unset for AWS). Objects must be publicly readable at S3_PUBLIC_URL.
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=sendcoop-media
S3_ACCESS_KEY_ID=sendcoop
S3_SECRET_ACCESS_KEY=sendcoop-dev-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9020/sendcoop-media
# Development and CI only: one extra certificate URL trusted for SNS webhook
# signatures, so tests can sign their own bounce notifications. Never set in production.
SNS_TEST_CERT_URL=http://localhost:3998/sns-test-cert.pem
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Sendcoop <no-reply@sendcoop.local>"

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Public URL of the edge app (click redirects, open pixel, postbacks).
TRACKING_URL=http://localhost:3001

# Encrypts secrets at rest (DKIM private keys, sending credentials). 32 random
# bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me

# Included in the SPF record customers add (the sending provider's SPF host).
SPF_INCLUDE=amazonses.com

# File storage (CSV uploads). Local folder in development; defaults to the OS temp dir.
# STORAGE_DIR=C:/sendcoop-storage

# AI assist (subject lines, email copy, draft automations) with Claude.
# Leave empty to turn it off. ANTHROPIC_BASE_URL is only for tests.
ANTHROPIC_API_KEY=

# Billing (Stripe). Leave empty to turn it off: everyone keeps their plan.
# Each paid plan needs its Stripe price id (Admin > Plans). Point a webhook at
# <app>/api/webhooks/stripe with the customer.subscription.* and
# checkout.session.completed events. STRIPE_API_BASE is only for tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# UTMCAP's API (defaults to https://app.utmcap.com/api/v1; tests use a fake).
# UTMCAP_API_URL=

# Daily currency rates for revenue in a workspace's reporting currency
# (default: the ECB's reference rates; "off" turns the job off).
# FX_RATES_URL=
