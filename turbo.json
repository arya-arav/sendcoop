{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "SMTP_*",
    "MAIL_FROM",
    "MAILPIT_URL",
    "BETTER_AUTH_*",
    "AUTH_RATE_LIMIT",
    "PW_CHANNEL",
    "CI",
    "STORAGE_DIR",
    "ENCRYPTION_KEY",
    "SPF_INCLUDE",
    "ALLOW_PRIVATE_SMTP_HOSTS",
    "SES_ENDPOINT",
    "DNS_SERVERS",
    "SNS_TEST_CERT_URL",
    "S3_*"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:integration": {
      "cache": false
    }
  }
}
