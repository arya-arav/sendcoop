{
  "name": "@sendcoop/edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@sendcoop/db": "workspace:*",
    "@sendcoop/redis": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5",
    "@sendcoop/mailer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
